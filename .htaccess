# design.faez.ai — static showcase (Apache / LiteSpeed on Hostinger)
DirectoryIndex index.html index.php

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

# not public yet: keep out of search results (same policy as faez.ai)
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
